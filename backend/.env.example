# Copy to backend/.env for local development. Never commit real keys.
TP_ENV=local
TP_DATABASE_URL=postgresql+asyncpg://tradepost:tradepost@localhost:5433/tradepost
TP_PUBLIC_ORIGIN=http://localhost:5180
TP_LOG_JSON=false

# Payments: TEST-MODE keys only.
